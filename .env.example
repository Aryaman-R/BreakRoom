# The main site is a STATIC EXPORT (next.config.mjs sets output: "export").
# Every variable here is inlined at BUILD time — there is no runtime to
# re-read them, so changing one means rebuilding, not restarting.
#
# Only NEXT_PUBLIC_* variables can reach a static export at all. There is no
# server, so DATABASE_URL, ANTHROPIC_API_KEY, and RESEND_API_KEY are gone:
# nothing could have read them, and a non-public key here would have been a
# trap for whoever filled it in.
#
# The ordering app in ordering/ is a separate application with its own
# .env.example and its own secrets. Nothing here applies to it.

# ---------------------------------------------------------------- required

# Canonical origin. Feeds metadataBase, so every og:image URL, canonical
# link, and the JSON-LD @id derive from it. If this is wrong at build time,
# every link shared to Slack/Messages/Facebook previews a broken image.
# Falls back to https://breakroombothell.com.
NEXT_PUBLIC_SITE_URL=https://breakroombothell.com

# The cafe's own order-ahead app — used by the nav, the homepage CTA, and
# the /online-order forwarding page. Defaults to
# https://order.breakroombothell.com in production builds and
# http://localhost:3100 under `next dev`. Set it to aim a preview build at
# a *.vercel.app deploy.
NEXT_PUBLIC_ORDER_URL=

# ---------------------------------------------------------------- optional

# Google Maps Embed API key for the /visit map. Without it the map falls
# back to a keyless embed, which works but is rate-limited. Restrict the key
# by HTTP referrer in the Google Cloud console before shipping.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
