# Database (when wired up)
DATABASE_URL=

# Anthropic Claude API for Beans assistant
ANTHROPIC_API_KEY=

# Email (Resend or Postmark)
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=hello@thebreakroom.cafe

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — advance menu ordering (pay-ahead pickup)
# Secret key (server only). Test keys start with sk_test_.
STRIPE_SECRET_KEY=
# Publishable key (exposed to the browser). Test keys start with pk_test_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (starts with whsec_). From the Stripe CLI
# (`stripe listen --forward-to localhost:3000/api/stripe/webhook`) or the
# Dashboard endpoint configured to POST /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Google Maps Embed API key (optional — falls back to keyless embed in dev).
# Restrict the key by HTTP referrer in the Google Cloud console before shipping.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
