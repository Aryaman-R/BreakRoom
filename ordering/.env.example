# Copy to .env.local and fill in. SETUP.md walks through where each value comes from.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never exposed to the browser. Bypasses RLS; all writes use it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (Console → Account Info) ---
# Leave all three empty during development: SMS bodies are logged to the server
# console instead, and (outside production) the verification code is returned
# to the client so the flow stays testable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Admin ---
# Comma-separated emails allowed into /admin (must also be Supabase Auth users).
ADMIN_EMAILS=

# Optional: set to 1 to let a DEPLOYED build without Twilio creds return the
# verification code in the API response (for pre-launch smoke tests only —
# remove before real customers use the site).
ALLOW_DEV_VERIFICATION=
